.warm-header {
  background: linear-gradient(180deg, #FFEBF0 0%, #FFF7F9 100%);
  padding: 30rpx 28rpx 16rpx 28rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.greeting-box {
  flex: 1;
  min-width: 0;
}

.greeting-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #3D2231;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.greeting-subtitle {
  font-size: 24rpx;
  color: #8C6A7B;
  margin-top: 6rpx;
  display: block;
}

/* 独立设备身份胶囊 */
.device-pill {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #FFD3DF;
  box-shadow: 0 4rpx 14rpx rgba(255, 82, 123, 0.12);
  border-radius: 40rpx;
  padding: 8rpx 16rpx 8rpx 12rpx;
  flex-shrink: 0;
  max-width: 280rpx;
  transition: transform 0.15s;
}

.device-pill:active {
  transform: scale(0.96);
}

.device-avatar {
  font-size: 36rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.device-info-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 8rpx;
  min-width: 0;
}

.device-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF4D7E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.device-model {
  font-size: 18rpx;
  color: #BFA0B3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.device-edit-icon {
  font-size: 20rpx;
  color: #FF4D7E;
  font-weight: 600;
  flex-shrink: 0;
}

/* 掌勺专属验证横幅 */
.chef-authorized-banner {
  background: linear-gradient(135deg, #3D2231 0%, #2A1722 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(61, 34, 49, 0.2);
  border: 1rpx solid #FF85A2;
}

.chef-banner-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.chef-banner-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.chef-banner-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #FFE4EA;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chef-banner-arrow {
  font-size: 22rpx;
  color: #FF85A2;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #FFE0E8;
  box-shadow: 0 4rpx 16rpx rgba(255, 117, 151, 0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  color: #FF85A1;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #3D2231;
}

.placeholder-color {
  color: #CDB4C2;
}

.clear-icon {
  font-size: 26rpx;
  color: #BFA0B3;
  padding: 0 10rpx;
  flex-shrink: 0;
}

/* 分类滚动横条 */
.category-scroll {
  white-space: nowrap;
  padding: 20rpx 24rpx 10rpx 24rpx;
  display: flex;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #FFE0E8;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.category-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-size: 26rpx;
  color: #6C4B5E;
  font-weight: 500;
}

.category-active {
  background: linear-gradient(135deg, #FF789A 0%, #FF4577 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 18rpx rgba(255, 69, 119, 0.3);
}

.category-active .category-name {
  color: #FFFFFF;
  font-weight: 700;
}

/* 菜品列表 */
.dishes-list {
  padding: 16rpx 24rpx 180rpx 24rpx;
}

.dish-card {
  padding: 22rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #FFE4EC;
}

.dish-card-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 18rpx;
}

.dish-visual-box {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE5EC 100%);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  border: 1rpx solid #FFD3DF;
  overflow: hidden;
}

.dish-real-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.dish-emoji {
  font-size: 64rpx;
}

.dish-time-badge {
  position: absolute;
  bottom: 8rpx;
  background: rgba(61, 34, 49, 0.75);
  color: #FFFFFF;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.dish-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dish-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #3D2231;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-category-tag {
  flex-shrink: 0;
  margin: 0;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin: 8rpx 0 6rpx 0;
  gap: 10rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: #7A5B6E;
  line-height: 32rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-ingredients-preview {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.ingredients-label {
  font-size: 20rpx;
  color: #BFA0B3;
  font-weight: 600;
  flex-shrink: 0;
}

.ingredients-text {
  font-size: 20rpx;
  color: #614856;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

/* 卡片底栏 */
.dish-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #FFDDE6;
  gap: 14rpx;
}

.dish-chef-badge {
  display: flex;
  align-items: center;
  background: #FFF5F7;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FFE4EA;
}

.dish-chef-badge-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.dish-chef-badge-text {
  font-size: 22rpx;
  color: #D36A89;
  font-weight: 500;
}

.cart-control {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.btn-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
}

.btn-minus {
  background: #FCEBF0;
  color: #7A5B6E;
}

.cart-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2231;
  margin: 0 16rpx;
}

.btn-plus {
  background: linear-gradient(135deg, #FF789A 0%, #FF4577 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(255, 69, 119, 0.35);
}

/* 底部浮动点餐篮条 */
.floating-cart-bar {
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  right: 28rpx;
  z-index: 99;
}

.cart-bar-content {
  background: #3D2231;
  border: 1rpx solid #FF85A2;
  border-radius: 50rpx;
  padding: 14rpx 20rpx 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 30rpx rgba(61, 34, 49, 0.3);
}

.cart-badge-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cart-icon-bg {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF789A 0%, #FF4577 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cart-icon {
  font-size: 34rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #FF4D7E;
  color: #FFF;
  font-size: 20rpx;
  font-weight: bold;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

.cart-summary {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cart-main-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-sub-text {
  color: #FFD4DF;
  font-size: 20rpx;
}

.btn-order-now {
  background: linear-gradient(135deg, #FF789A 0%, #FF4577 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  padding: 18rpx 32rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(255, 69, 119, 0.35);
  flex-shrink: 0;
}

.arrow-right {
  margin-left: 8rpx;
}

/* 模态弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 34, 49, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: #FFFFFF;
  width: 100%;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)) 32rpx;
  animation: slideUp 0.25s ease-out;
  border-top: 3rpx solid #FF85A2;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #3D2231;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #8C6A7B;
  margin: 10rpx 0 24rpx 0;
  display: block;
}

.role-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  background: #FFF5F7;
  border: 1rpx solid transparent;
}

.role-card-active {
  background: #FFE8EF;
  border-color: #FF4D7E;
}

.role-avatar {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.role-name {
  font-size: 24rpx;
  color: #3D2231;
  font-weight: 600;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #553549;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  background: #FFF5F7;
  border: 1rpx solid #FFD3DF;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #3D2231;
}

.modal-save-btn {
  margin-top: 24rpx;
  width: 100%;
}

.secret-chef-door {
  text-align: center;
  padding: 24rpx 0 10rpx 0;
}

.secret-text {
  font-size: 22rpx;
  color: #C29EB1;
  text-decoration: underline;
}

.chef-unlocked {
  color: #4CAF50;
  font-weight: 600;
  text-decoration: none;
}

.list-load-hint {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #FF527B;
  font-weight: 500;
}

.list-end-hint {
  text-align: center;
  padding: 40rpx 0 100rpx 0;
  font-size: 22rpx;
  color: #B59BAA;
}
