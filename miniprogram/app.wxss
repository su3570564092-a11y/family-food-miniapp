/** 🐾 软萌小猫咪专属·甜美草莓粉色系全局样式 **/
page {
  /* 甜美猫咪肉垫粉 + 草莓奶冻粉温润配色 */
  --primary-color: #FF527B;
  --primary-light: #FFEBF0;
  --primary-gradient: linear-gradient(135deg, #FF789A 0%, #FF4577 100%);
  --cat-pink: #FF85A2;
  --cat-paw-pink: #FFD4DF;
  --cat-accent: #FFA69E;
  --cat-warm: #FFE4EA;
  --bg-page: #FFF6F8;
  --card-bg: #FFFFFF;
  --text-main: #3D2231;
  --text-sub: #7A5B6E;
  --text-muted: #BFA0B3;
  --border-pink: #FFDDE6;
  --border-paw: #FFE4EC;
  --radius-sm: 18rpx;
  --radius-md: 30rpx;
  --radius-lg: 44rpx;
  --shadow-pink: 0 10rpx 30rpx rgba(255, 82, 123, 0.12);
  --shadow-paw: 0 12rpx 32rpx rgba(255, 117, 151, 0.18);

  background-color: var(--bg-page);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
}

view, text, image, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* 页面通用布局 */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-page);
}

/* 甜美粉色猫咪卡片 */
.cozy-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-pink);
  border: 2rpx solid var(--border-pink);
  padding: 26rpx;
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
}

.cozy-card:active {
  transform: scale(0.99);
}

/* 猫咪温馨徽章与标签 (防垂直变形与排版塌陷) */
.tag-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 32rpx;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  box-sizing: border-box;
  vertical-align: middle;
  text-align: center;
  white-space: nowrap;
}

.tag-pink {
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 600;
  border: 1rpx solid #FFD3DF;
}

.tag-cat {
  background: #FFF0F4;
  color: #FF527B;
  font-weight: 600;
  border: 1rpx solid #FFCCD8;
}

.tag-neutral {
  background: #FDF2F5;
  color: #8C6A7B;
}

/* 按钮通用 */
.btn-primary {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 22rpx 36rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 69, 119, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  opacity: 0.92;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 18rpx 30rpx;
  text-align: center;
}

/* 浮动与阴影 */
.shadow-box {
  box-shadow: var(--shadow-pink);
}

/* 弹性盒常用工具 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态粉色提示 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-muted);
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
}

.empty-subtext {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
